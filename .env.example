# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only for server-side seeding/admin scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox access token (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Team check-ins (SMS via GoHighLevel) ---
# Private Integration token (GHL Settings -> Private Integrations). Needs the
# contacts.write and conversations/message.write scopes.
GHL_API_KEY=
# Sub-account (location) ID the texts are sent from.
GHL_LOCATION_ID=
# Shared secret for the inbound webhook. Put it in the webhook URL as
# https://<your-app>/api/ghl/inbound?secret=<value>
GHL_WEBHOOK_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/check-ins.
CRON_SECRET=
# Optional: Claude reads each reply and flags delays/blockers.
ANTHROPIC_API_KEY=

# --- Accounting: automatic bank feed (Plaid) ---
# Optional. Without these, upload statement CSVs on /accounting instead.
# Keys: https://dashboard.plaid.com/developers/keys. Also needs
# SUPABASE_SERVICE_ROLE_KEY (the access token is stored service-role only).
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox (test banks, user_good / pass_good) or production
PLAID_ENV=sandbox
