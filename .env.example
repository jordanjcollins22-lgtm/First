# Usually leave this blank. Links a client follows — a proposal, a booking
# link — are built from the project's production domain, which Vercel provides
# to every deployment automatically as VERCEL_PROJECT_PRODUCTION_URL. Set this
# only to override that: several custom domains on one project, say, where
# Vercel's pick is not the one clients should see. Falls back to the request
# host when neither is available, which is what happens locally.
NEXT_PUBLIC_APP_URL=

# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only for server-side seeding/admin scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox access token (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# RentCast API key (https://app.rentcast.io/app/api) — used to auto-fill a
# new property's square footage and lot acreage. Server-side only.
RENTCAST_API_KEY=

# Anthropic API key (https://console.anthropic.com/settings/keys) — powers the
# admin-only "Ask Claude" assistant, which can look up clients and update job
# schedules on request. Server-side only.
ANTHROPIC_API_KEY=

# Stripe secret key (https://dashboard.stripe.com/apikeys) — sends an actual
# payable invoice once a client accepts a proposal. Server-side only.
STRIPE_SECRET_KEY=
# Signing secret for the /api/webhooks/stripe endpoint (Stripe dashboard ->
# Developers -> Webhooks -> your endpoint -> Signing secret).
STRIPE_WEBHOOK_SECRET=

# Shared secret for the scheduled appointment-reminder endpoint. Vercel Cron
# sends it automatically; any other scheduler must send
# "Authorization: Bearer <value>". Leave blank to disable the check.
CRON_SECRET=
# Harford County GIS. A layer URL (…/MapServer/3), a service, or the catalog root.
HARFORD_GIS_URL=

# LiveKit (https://cloud.livekit.io) — powers internal video calls, screen
# sharing, and the shared drawing overlay. The URL is public (the browser
# connects to it); the key and secret are server-side only.
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# OpenAI API key (https://platform.openai.com/api-keys) — transcribes voice
# memos sent in internal group chats. Without it a memo still records, sends,
# and plays; it just won't have a transcript. Server-side only.
OPENAI_API_KEY=

# Twilio (https://console.twilio.com) — sends the text-message notifications
# people turn on for themselves: appointment reminders, client messages,
# proposal responses, and internal group messages. Server-side only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ---------------------------------------------------------------------------
# Services used with no key required — nothing to configure, listed so the
# set of outside services the app depends on is all in one place.
#
#   Open-Meteo   https://open-meteo.com     forecasts on the Weather tab
#   RainViewer   https://www.rainviewer.com radar overlay on the weather map
# ---------------------------------------------------------------------------

# Sends email — proposals, invoices, and marketing campaigns.
# Which domains and addresses we send from are set up inside the app under
# Settings → Email, not here: those change, and needing a redeploy to add an
# address is a reason nobody adds the address.
RESEND_API_KEY=
