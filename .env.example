# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only for server-side seeding/admin scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox access token (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# --- Team check-ins (SMS via GoHighLevel) ---
# Private Integration token (GHL Settings -> Private Integrations). Needs the
# contacts.write and conversations/message.write scopes.
GHL_API_KEY=
# Sub-account (location) ID the texts are sent from.
GHL_LOCATION_ID=
# Shared secret for the inbound webhook. Put it in the webhook URL as
# https://<your-app>/api/ghl/inbound?secret=<value>
GHL_WEBHOOK_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" to /api/cron/check-ins.
CRON_SECRET=
# Claude: reads check-in replies, and runs the communications agent.
# Without it, messages are still logged but nobody answers them automatically.
ANTHROPIC_API_KEY=

# --- Communications agent ---
# "draft" (default): replies to customers wait for a manager to approve them
# in /inbox or by texting back. "auto": routine customer replies go out
# immediately; anything sensitive is still held.
AGENT_CUSTOMER_MODE=draft
# Public URL of the app, used in the no-login links texted to employees.
# Defaults to the Vercel production URL.
APP_URL=
