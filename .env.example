# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only for server-side seeding/admin scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox access token (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Government contracting pipeline (/govcon) — see docs/govcon/README.md
# Only the Supabase service-role key above and CRON_SECRET are required;
# everything else switches on more automation.
# ---------------------------------------------------------------------------
# Protects /api/cron/govcon (Vercel Cron sends it automatically)
CRON_SECRET=
# Password for the /govcon dashboard
GOVCON_DASHBOARD_PASSWORD=
# Public base URL used in quote-request links (defaults to the Vercel URL)
GOVCON_APP_URL=
# Claude reads solicitations, writes sub scopes, checks quotes, drafts proposals
ANTHROPIC_API_KEY=
# Finds local subcontractors near each job (Places API (New) Text Search)
GOOGLE_PLACES_API_KEY=
# Sends quote requests to subs + your daily digest (https://resend.com)
RESEND_API_KEY=
GOVCON_FROM_EMAIL="Your Company <bids@yourdomain.com>"
GOVCON_REPLY_TO=
GOVCON_OWNER_EMAIL=
# Optional: same-day SAM.gov notices (the keyless daily CSV is used regardless)
SAM_API_KEY=
