# Supabase project credentials (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only for server-side seeding/admin scripts. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Mapbox access token (https://account.mapbox.com/access-tokens/)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ---- Winter Pass funnel ----
# Stripe (test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# GoHighLevel (Private Integration token + location)
GHL_API_KEY=
GHL_LOCATION_ID=
# Weather (NWS needs no key; OpenWeather is the fallback)
OPENWEATHER_API_KEY=
# Admin dashboard password and cron auth
ADMIN_PASSWORD=
CRON_SECRET=
# Google Ads conversion tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
