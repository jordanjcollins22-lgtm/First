{
  "manifest_version": 3,
  "name": "JS Landscaping: lead finder",
  "description": "Finds recent Facebook posts from Harford County neighbors asking for yard work, types a comment with your tracked link for you to post, and schedules approved before-and-after posts.",
  "version": "3.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open the JS Landscaping lead finder",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://app.jslandscapingmd.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "shared.js",
        "finder.js"
      ],
      "css": [
        "finder.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
