{
  "manifest_version": 3,
  "name": "JS Landscaping: group agent",
  "description": "Looks through your Facebook groups for neighbours asking for lawn and landscaping work, has the app write the comment with a tracked link, and posts it under the caps you set in the app.",
  "version": "2.1.0",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "JS Landscaping group agent",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "permissions": ["activeTab", "scripting", "alarms", "tabs", "storage", "notifications"],
  "host_permissions": ["https://www.facebook.com/*", "https://app.jslandscapingmd.com/*"],
  "background": { "service_worker": "background.js" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open the agent"
    }
  }
}
